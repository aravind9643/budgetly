{
  "expo": {
    "name": "Budgetly",
    "slug": "budgetly",
    "scheme": "budgetly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aravind9643.budgetly"
    },
    "android": {
      "package": "com.aravind9643.budgetly"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Budgetly",
      "shortName": "Budgetly"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Budgetly uses your photos to attach receipts to expenses.",
          "cameraPermission": "Budgetly uses the camera to photograph receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
